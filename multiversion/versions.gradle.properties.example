# 每个版本放到 versions/<版本>/gradle.properties 里（Stonecutter 的多版本属性文件）。
# 下面的数值已按 Fabric 官方索引核对（2026-02）：1.19.4 / 1.20.1 用 Java 17，
# 1.21.11 / 26.3 用 Java 21，26.3 没有 Yarn，改用官方映射。

# ---------- 1.19.4（当前已编译验证） ----------
# minecraft_version=1.19.4
# yarn_mappings=1.19.4+build.2
# loader_version=0.19.5
# fabric_api_version=0.87.2+1.19.4
# java_version=17

# ---------- 1.20.1 ----------
# minecraft_version=1.20.1
# yarn_mappings=1.20.1+build.10
# loader_version=0.20.1
# fabric_api_version=0.92.12+1.20.1
# java_version=17

# ---------- 1.21.11 ----------
# minecraft_version=1.21.11
# yarn_mappings=1.21.11+build.6
# loader_version=0.20.1
# fabric_api_version=0.141.6+1.21.11
# java_version=21

# ---------- 26.3 ----------
# minecraft_version=26.3
# yarn_mappings=（无，改用 loom.officialMojangMappings()）
# loader_version=0.20.1
# fabric_api_version=0.165.0+26.3
# java_version=21
